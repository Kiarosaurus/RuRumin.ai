# Base URL of the FastAPI backend. Injected at build time by Vite.
# Local dev (optional — defaults to http://localhost:8000 in `vite dev`):
VITE_API_BASE_URL=http://localhost:8000
# Production build (packaged .exe) — point at the real Cloud Run URL:
# VITE_API_BASE_URL=https://rurumin-api-xxxxxxxx-uc.a.run.app
