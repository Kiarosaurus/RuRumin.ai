# Backend environment variables.
# Copy to backend/.env for local development (do NOT commit the real .env).

# Required: API key for the Google Generative AI (Gemini) SDK.
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: comma-separated CORS allow-list.
# Defaults to the Vite dev server + Tauri webview schemes when unset.
# ALLOWED_ORIGINS=http://localhost:1420,tauri://localhost,https://tauri.localhost
